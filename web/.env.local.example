# Copy to .env.local. The frontend fetches the backend both server-side (React
# Server Components) and from the browser (page images), so this URL must be
# reachable from both — localhost works when everything runs on your machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The demo tenant created by `make seed`. Sent as the X-Tenant-Id header
# (there is no real auth yet).
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001

# The matter created by `make seed`.
NEXT_PUBLIC_MATTER_ID=00000000-0000-0000-0000-000000000002
