# Copy to .env at the repo root:  cp .env.example .env
# Docker Compose reads this for ${VAR} interpolation; the backend reads it too.
# .env is git-ignored.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Only needed for non-Docker runs (Compose sets these itself for containers).
DATABASE_URL=postgresql+psycopg://ocr_app:ocr_app@localhost:5433/ocr_rag
REDIS_URL=redis://localhost:6379/0

# --- Storage + OCR -------------------------------------------------------
# S3_ENDPOINT_URL is the storage host as seen FROM THE CONTAINERS:
#   http://minio:9000  -> local MinIO (default). OCR still calls real Textract,
#                         so it needs real AWS keys to succeed.
#   (blank)            -> real AWS S3. Fill in the real bucket/region/keys.
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ocr-rag-dev
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Filled in during later stages ---
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
