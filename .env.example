# Copy to .env for local non-Docker runs. Docker Compose sets these itself.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Application connects as the RLS-enforced role (NOT a superuser).
# Host port 5433 maps to the Docker Postgres (5432 stays free for a native one).
DATABASE_URL=postgresql+psycopg://ocr_app:ocr_app@localhost:5433/ocr_rag

REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally, S3 in AWS).
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ocr-rag-documents
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Filled in during later stages ---
# AZURE_DI_ENDPOINT=
# AZURE_DI_KEY=
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
